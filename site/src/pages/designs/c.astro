---
import DesignLayout from '../../layouts/DesignLayout.astro';
import Story from '../../components/Story.astro';
import TentacleField from '../../components/TentacleField.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const repo = 'https://github.com/y0c0ms/sesync';
const sections = [
  ["what", "What it is"],
  ["tui", "TUI"],
  ["herdr", "herdr"],
  ["phone", "Phone"],
  ["machines", "Machines"],
  ["flags", "Commands"],
  ["install", "Install"],
];
---

<DesignLayout
  variant="v-c"
  title="sesync · deep"
  description="Design C for the sesync page: layered sea gradients, glass cards, a sticky rail and tentacles that curl toward the pointer."
>
  <nav class="rail" aria-label="Sections">
    {sections.map(([id, label]) => <a href={`#${id}`} data-rail={id}>{label}</a>)}
  </nav>

  <section class="hero">
    <TentacleField seed={5} arms={8} palette="silver" />
    <div class="hero-copy">
      <span class="kicker"><b>sesync</b> v0.1.0 · MIT · Linux and Windows builds</span>
      <h1>One conversation, every harness.</h1>
      <p class="lead">Start a conversation in omp, continue it in Pi, pick it up in OpenCode, resume it in Claude Code or Antigravity. sesync converts each copy, keeps them in step, and locks the conversation while a turn is running.</p>
      <p>A TUI on the machine, a popup inside herdr, a bridge for the phone, and prompts that travel from one machine to another.</p>
      <div class="actions">
        <a class="button primary" href={`${repo}/releases`}>Download v0.1.0</a>
        <a class="button" href={repo}>Source on GitHub</a>
        <a class="button" href="#herdr">See the herdr popup</a>
      </div>
    </div>
    <div class="hero-media">
      <figure class="recording">
        <div class="screen">
          <video autoplay loop muted playsinline preload="metadata" poster={`${base}media/popup-herdr.webp`} aria-label="The sesync TUI opening as a herdr popup">
            <source src={`${base}media/popup-herdr.mp4`} type="video/mp4" />
          </video>
        </div>
        <figcaption>The TUI as a herdr popup: <kbd>ctrl+alt+s</kbd>, pick a session, <kbd>o</kbd> opens it in a tab.</figcaption>
      </figure>
    </div>
  </section>

  <Story />

  <script>
    // Scrollspy for the rail: the link of the section crossing the middle of the viewport lights up.
    const links = new Map<string, HTMLElement>();
    for (const a of document.querySelectorAll<HTMLElement>("[data-rail]")) links.set(a.dataset.rail!, a);
    const pick = () => {
      const mid = window.innerHeight * 0.4;
      let best: { id: string; dist: number } | null = null;
      for (const [id, a] of links) {
        const section = document.getElementById(id);
        if (!section) continue;
        const r = section.getBoundingClientRect();
        if (r.top <= mid && r.bottom >= mid) { best = { id, dist: 0 }; break; }
        const dist = Math.min(Math.abs(r.top - mid), Math.abs(r.bottom - mid));
        if (!best || dist < best.dist) best = { id, dist };
      }
      for (const [id, a] of links) a.classList.toggle("on", id === best?.id);
    };
    addEventListener("scroll", pick, { passive: true });
    pick();
  </script>
</DesignLayout>
