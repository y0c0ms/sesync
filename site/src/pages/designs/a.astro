---
import DesignLayout from '../../layouts/DesignLayout.astro';
import Story from '../../components/Story.astro';
import Tentacles from '../../components/Tentacles.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const repo = 'https://github.com/y0c0ms/sesync';
---

<DesignLayout
  variant="v-a"
  title="sesync · obsidian"
  description="Design A for the sesync page: obsidian, silver and a hint of sea-green, with tentacles that follow the pointer."
>
  <section class="hero">
    <Tentacles seed={11} arms={9} class="hero-tentacles" />
    <div class="hero-copy">
      <span class="kicker"><b>sesync</b> v0.1.0 · MIT · Linux and Windows builds</span>
      <h1>One conversation, every harness.</h1>
      <p class="lead">Start a conversation in omp, continue it in Pi, pick it up in OpenCode, resume it in Claude Code or Antigravity. sesync converts each copy, keeps them in step, and locks the conversation while a turn is running.</p>
      <p>A TUI on the machine, a popup inside herdr, a bridge for the phone, and prompts that travel from one machine to another.</p>
      <div class="actions">
        <a class="button primary" href={`${repo}/releases`}>Download v0.1.0</a>
        <a class="button" href={repo}>Source on GitHub</a>
        <a class="button" href="#herdr">See the herdr popup</a>
      </div>
    </div>
    <div class="hero-media">
      <figure class="recording">
        <div class="screen">
          <video autoplay loop muted playsinline preload="metadata" poster={`${base}media/popup-herdr.webp`} aria-label="The sesync TUI opening as a herdr popup">
            <source src={`${base}media/popup-herdr.mp4`} type="video/mp4" />
          </video>
        </div>
        <figcaption>The TUI as a herdr popup: <kbd>ctrl+alt+s</kbd>, pick a session, <kbd>o</kbd> opens it in a tab.</figcaption>
      </figure>
    </div>
  </section>

  <section>
    <ul class="cheat">
      <li><b>sesync --tui</b> sessions, team, machines</li>
      <li><b>ctrl+p</b> palette</li>
      <li><b>ctrl+alt+s</b> popup in herdr</li>
      <li><b>sesync machine prompt</b> another machine</li>
      <li><b>sesync bridge serve</b> the phone</li>
    </ul>
  </section>

  <Story />
</DesignLayout>
