---
import DesignLayout from '../../layouts/DesignLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const designs = [
  {
    id: "a",
    name: "Obsidian tide",
    note: "Brand-true: near-black, silver type, sea-green accent. Tentacles follow the pointer.",
    swatches: ["#0b0c0e", "#a9b3b7", "#7fd6c4"],
  },
  {
    id: "b",
    name: "Paper and ink",
    note: "Warm paper, serif headings, numbered sections. Line-art tentacles, a printed mark in the corner.",
    swatches: ["#f2eee4", "#15171a", "#0f6d5c"],
  },
  {
    id: "c",
    name: "Deep",
    note: "Layered sea gradients, glass cards, a rail that tracks the section, drawn tentacles that curl as you move. This one is the live page.",
    swatches: ["#06100f", "#7cf0d8", "#24b596"],
  },
];
---

<DesignLayout
  chooser={false}
  variant="v-a"
  title="sesync · three designs"
  description="Three designs for the sesync project page, all built on the Agent Hub mark's colours."
>
  <section class="hero" style="display:block; padding-bottom: 1rem">
    <div class="hero-copy" style="max-width: 46rem">
      <span class="kicker"><b>sesync</b> three designs</span>
      <h1>Pick one.</h1>
      <p class="lead">The same words and recordings, three skins drawn from the Agent Hub mark: obsidian, silver, sea-green. Each one is a real page; open it, scroll it, move the pointer.</p>
    </div>
  </section>

  <section style="border-top:0">
    <div class="pick">
      {designs.map((d) => (
        <a class="card" href={`${base}designs/${d.id}/`}>
          <div class="strip" aria-hidden="true">
            {d.swatches.map((c) => <span style={`background:${c}`}></span>)}
          </div>
          <h2>{d.name}</h2>
          <p>{d.note}</p>
          <span class="go">Open design {d.id.toUpperCase()} →</span>
        </a>
      ))}
    </div>
    <p class="small" style="margin-top:1.4rem">The live page stays where it is; these are the candidates.</p>
  </section>

  <style>
    .pick {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 1.5rem;
    }
    .card {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 1.1rem 1.1rem 1.3rem;
      border: 1px solid var(--line-strong);
      border-radius: 14px;
      background: #101317;
      color: var(--ink);
      text-decoration: none;
      transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    }
    .card:hover {
      transform: translateY(-3px);
      border-color: var(--accent);
      box-shadow: 0 20px 50px rgb(0 0 0 / 45%), 0 0 0 1px rgb(127 214 196 / 25%);
    }
    .card h2 { margin: 0.6rem 0 0; font-size: 1.25rem; }
    .card p { margin: 0; color: var(--ink-soft); font-size: 0.92rem; }
    .card .go { margin-top: auto; padding-top: 0.8rem; color: var(--accent-ink); font: 500 0.85rem/1.4 var(--mono); }
    .strip { display: flex; gap: 4px; height: 8px; border-radius: 999px; overflow: hidden; }
    .strip span { flex: 1; }
  </style>
</DesignLayout>
