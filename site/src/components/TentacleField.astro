---
/**
 * TentacleField: octopus arms entering from the right wall of the viewport, drawn with the
 * anatomy the reference art shows — a tapered body with a lit upper edge and a shaded
 * underside, creases across the flesh, and two staggered rows of suckers that shrink toward
 * the tip. Generated from a seed, so the same build always draws the same field.
 *
 * Motion: the arms sway continuously (CSS), the pointer turns them a little, and pointing at
 * the right of the page makes them sway harder. All transforms, so nothing re-renders.
 */
interface Props {
  arms?: number;
  seed?: number;
  class?: string;
  opacity?: number;
}

const { arms = 6, seed = 5, class: cls = "", opacity = 1 } = Astro.props;

function rng(s: number) {
  let a = s >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);
const STEPS = 96;

type Pt = { x: number; y: number; a: number; w: number };
type Sucker = { cx: number; cy: number; rx: number; ry: number; rot: number };
type Arm = {
  id: string;
  body: string;
  shade: string;
  rim: string;
  creases: string[];
  suckers: Sucker[];
  f: number;
  g: [number, number, number, number];
  base: [number, number];
};

const poly = (pts: string[]) => `M ${pts.join(" L ")} Z`;
const field: Arm[] = [];

for (let i = 0; i < arms; i++) {
  const t0 = (i + 0.5) / arms;
  // Bases start past the wall so each arm is cropped flush against it.
  let x = 1406 + rand() * 40;
  let y = 6 + t0 * 700 + (rand() - 0.5) * 52;
  let theta = Math.PI + (rand() - 0.5) * 0.55;
  const baseX = x;
  const baseY = y;

  const length = 520 + rand() * 600;
  const waveAmp = 0.14 + rand() * 0.2;
  const waveFreq = 0.65 + rand() * 0.9;
  const phase = rand() * Math.PI * 2;
  const curl = 2.1 + rand() * 2.8;
  const baseWidth = 30 + rand() * 26;
  const plump = 2.6 + rand() * 2.4;

  const spine: Pt[] = [];
  const ds = length / STEPS;
  for (let s = 0; s <= STEPS; s++) {
    const t = s / STEPS;
    // Body: a long taper, a gentle bulge mid-arm, and a hooked tip.
    const w = baseWidth * (Math.pow(1 - t, 0.72) * (1 + 0.14 * Math.sin(t * plump)) + 0.06) + 2.2;
    spine.push({ x, y, a: theta, w });
    const bend =
      Math.sin(t * Math.PI * 2 * waveFreq + phase) * waveAmp +
      Math.sin(t * Math.PI * 9.5 + phase * 2) * 0.045 + // second octave: less mechanical
      curl * t * t;
    theta += (bend * ds) / length * 3.1;
    x += Math.cos(theta) * ds;
    y += Math.sin(theta) * ds;
  }

  const upper: string[] = [];
  const lower: string[] = [];
  const shadeOuter: string[] = [];
  const shadeInner: string[] = [];
  const rimPts: string[] = [];
  const creases: string[] = [];
  const suckers: Sucker[] = [];

  for (let s = 0; s <= STEPS; s++) {
    const p = spine[s];
    const t = s / STEPS;
    const nx = Math.cos(p.a + Math.PI / 2);
    const ny = Math.sin(p.a + Math.PI / 2);
    const up = p.w * 0.94;
    const down = p.w * 0.86;
    upper.push(`${(p.x + nx * up).toFixed(1)},${(p.y + ny * up).toFixed(1)}`);
    lower.push(`${(p.x - nx * down).toFixed(1)},${(p.y - ny * down).toFixed(1)}`);
    // The underside band catches less light: from just below the spine to the lower edge.
    shadeOuter.push(`${(p.x - nx * down * 0.98).toFixed(1)},${(p.y - ny * down * 0.98).toFixed(1)}`);
    shadeInner.push(`${(p.x - nx * down * 0.12).toFixed(1)},${(p.y - ny * down * 0.12).toFixed(1)}`);
    if (s % 3 === 0) {
      rimPts.push(`${(p.x + nx * up * 0.82).toFixed(1)},${(p.y + ny * up * 0.82).toFixed(1)}`);
    }
    // Creases: short arcs across the flesh, denser near the base where the arm is thicker.
    if (s % 9 === 0 && t > 0.06 && t < 0.9) {
      const tx = Math.cos(p.a);
      const ty = Math.sin(p.a);
      const ax = p.x + nx * up * 0.92;
      const ay = p.y + ny * up * 0.92;
      const bx = p.x - nx * down * 0.92;
      const by = p.y - ny * down * 0.92;
      const mx = p.x + tx * p.w * 0.1;
      const my = p.y + ty * p.w * 0.1;
      creases.push(
        `M ${ax.toFixed(1)} ${ay.toFixed(1)} Q ${mx.toFixed(1)} ${my.toFixed(1)} ${bx.toFixed(1)} ${by.toFixed(1)}`
      );
    }
    // Suckers: two staggered rows along the underside, shrinking toward the tip.
    if (s > 4 && s < STEPS - 3 && s % 6 === 0) {
      const row = (s / 6) % 2 === 0 ? 0.42 : 0.66;
      const size = p.w * 0.3 * (1 - 0.35 * t);
      suckers.push({
        cx: Number((p.x - nx * down * row).toFixed(1)),
        cy: Number((p.y - ny * down * row).toFixed(1)),
        rx: Number((size * 1.15).toFixed(1)),
        ry: Number((size * 0.78).toFixed(1)),
        rot: Number(((p.a * 180) / Math.PI).toFixed(1))
      });
    }
  }

  field.push({
    id: `arm-${seed}-${i}`,
    body: poly([...lower, ...upper.slice().reverse()]),
    shade: poly([...shadeOuter, ...shadeInner.slice().reverse()]),
    rim: `M ${rimPts.join(" L ")}`,
    creases,
    suckers,
    f: ((i % 2 === 0 ? 1 : -1) * (0.4 + rand() * 0.9)).toFixed(2),
    g: [baseX, baseY, spine[STEPS].x, spine[STEPS].y],
    base: [baseX, baseY]
  });
}
---

<svg
  class:list={["tentacle-field", cls]}
  viewBox="0 0 1400 700"
  preserveAspectRatio="xMaxYMid slice"
  aria-hidden="true"
  data-tentacle-field
  style={`opacity:${opacity}`}
>
  <defs>
    {field.map((arm) => (
      <linearGradient id={arm.id} gradientUnits="userSpaceOnUse" x1={arm.g[0]} y1={arm.g[1]} x2={arm.g[2]} y2={arm.g[3]}>
        <stop offset="0" stop-color="var(--arm-base)" />
        <stop offset="0.42" stop-color="var(--arm-mid)" />
        <stop offset="1" stop-color="var(--arm-tip)" />
      </linearGradient>
    ))}
    <linearGradient id={`shade-${seed}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#000" stop-opacity="0" />
      <stop offset="1" stop-color="var(--arm-shadow)" stop-opacity="0.62" />
    </linearGradient>
    <radialGradient id={`socket-${seed}`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="var(--arm-shadow)" stop-opacity="0.85" />
      <stop offset="1" stop-color="var(--arm-shadow)" stop-opacity="0" />
    </radialGradient>
  </defs>

  {field.map((arm, i) => (
    <g class="arm-outer" style={`--f:${arm.f};--i:${i};--dur:${(6.2 + (i % 3) * 1.7).toFixed(1)}s`}>
      <g class="arm">
        <path d={arm.body} fill="var(--arm-shadow)" opacity="0.35" transform="translate(9 13)" />
        <path d={arm.body} fill={`url(#${arm.id})`} stroke="var(--arm-outline)" stroke-width="2.4" stroke-linejoin="round" />
        <path d={arm.shade} fill={`url(#shade-${seed})`} />
        <path d={arm.rim} fill="none" stroke="var(--arm-rim)" stroke-width="2.6" stroke-linecap="round" opacity="0.5" />
        <g stroke="var(--arm-outline)" stroke-width="1.05" opacity="0.22" fill="none">
          {arm.creases.map((d) => <path d={d} />)}
        </g>
        {arm.suckers.map((s) => (
          <g transform={`rotate(${s.rot} ${s.cx} ${s.cy})`}>
            <ellipse cx={s.cx} cy={s.cy} rx={s.rx} ry={s.ry} fill="var(--arm-sucker)" stroke="var(--arm-outline)" stroke-width="1.15" />
            <ellipse cx={s.cx} cy={s.cy} rx={s.rx * 0.52} ry={s.ry * 0.52} fill="var(--arm-shadow)" opacity="0.5" />
          </g>
        ))}
        <ellipse cx={arm.base[0]} cy={arm.base[1]} rx="54" ry="46" fill={`url(#socket-${seed})`} />
      </g>
    </g>
  ))}
</svg>

<script>
  // Continuous sway lives in CSS; this only steers it: the pointer turns the arms a little, and
  // pointing at the right of the page (where they are) excites them.
  const fields = document.querySelectorAll<SVGSVGElement>("[data-tentacle-field]");
  if (fields.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const step = () => {
      x += (tx - x) * 0.05;
      y += (ty - y) * 0.05;
      for (const svg of fields) {
        svg.style.setProperty("--turn", x.toFixed(3));
        svg.style.setProperty("--rise", y.toFixed(3));
      }
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0015 ? requestAnimationFrame(step) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(step); };
    addEventListener("pointermove", (e) => {
      tx = (e.clientX / innerWidth - 0.5) * 2;
      ty = (e.clientY / innerHeight - 0.5) * 2;
      document.documentElement.classList.toggle("arms-awake", e.clientX > innerWidth * 0.55);
      kick();
    }, { passive: true });
    addEventListener("pointerleave", () => {
      tx = 0; ty = 0;
      document.documentElement.classList.remove("arms-awake");
      kick();
    });
  }
</script>

<style>
  @property --amp {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  .tentacle-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    --turn: 0;
    --rise: 0;
    --amp: 1;

    /* The mark's palette: silver flesh, a cold shadow, a sea-green tip. */
    --arm-base: #131b21;
    --arm-mid: #869499;
    --arm-tip: #cfeee6;
    --arm-outline: #04080a;
    --arm-rim: #eafaf5;
    --arm-sucker: #dfe9e6;
    --arm-shadow: #0a1418;
  }

  .tentacle-field .arm-outer {
    transform-box: fill-box;
    transform-origin: 100% 50%;
    transform: translateY(calc(var(--rise) * 7px)) rotate(calc(var(--f) * var(--turn) * 2.2deg));
  }

  .tentacle-field .arm {
    transform-box: fill-box;
    transform-origin: 100% 50%;
    animation:
      arm-sway var(--dur, 7s) ease-in-out infinite alternate,
      arm-drift calc(var(--dur, 7s) * 1.7) ease-in-out infinite alternate;
    animation-delay: calc(var(--i, 0) * -1.15s), calc(var(--i, 0) * -2.1s);
    transition: --amp 420ms ease;
    will-change: transform;
  }

  html.arms-awake .tentacle-field .arm { --amp: 2.6; }

  @keyframes arm-sway {
    from { transform: rotate(calc(var(--amp) * -0.9deg)) translateY(calc(var(--amp) * -3px)); }
    to   { transform: rotate(calc(var(--amp) * 0.9deg)) translateY(calc(var(--amp) * 2px)); }
  }

  @keyframes arm-drift {
    from { scale: calc(1 - var(--amp) * 0.004); }
    to   { scale: calc(1 + var(--amp) * 0.006); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tentacle-field .arm,
    .tentacle-field .arm-outer { animation: none; transform: none; }
  }
</style>
