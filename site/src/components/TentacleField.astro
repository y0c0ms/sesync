---
/**
 * TentacleField: octopus arms drawn as filled ribbons, the way the reference art does it —
 * tapered body, dark outline, light rim, rows of suckers — generated from a seed so the same
 * build always draws the same field. They enter from the right edge and curl into the page.
 *
 * Motion is CSS only: the pointer sets two variables, each arm turns a little by its own factor.
 */
interface Props {
  arms?: number;
  seed?: number;
  /** "right" arms enter the right edge (hero); "bottom" arms rise from below. */
  from?: "right" | "bottom";
  class?: string;
  /** Palette override element: "silver" (brand) or "coral" (the reference art's warmth). */
  palette?: "silver" | "coral";
  opacity?: number;
}

const { arms = 8, seed = 3, from = "right", class: cls = "", palette = "silver", opacity = 1 } = Astro.props;

function rng(s: number) {
  let a = s >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);
const STEPS = 64;

type Arm = {
  out: string;
  rim: string;
  suckers: { cx: string; cy: string; rx: string; ry: string; rot: string }[];
  f: number;
  id: string;
};

const field: Arm[] = [];
for (let i = 0; i < arms; i++) {
  // Where the arm leaves the edge, and which way it starts off.
  const t0 = (i + 0.5) / arms;
  let x: number, y: number, theta: number;
  if (from === "right") {
    // Bases start a little past the wall so each arm is cropped flush against it, as in the
    // reference art: the thick end is never a visible rounded cap.
    x = 1404 + rand() * 46;
    y = 10 + t0 * 700 + (rand() - 0.5) * 46;
    theta = Math.PI + (rand() - 0.5) * 0.7; // heading left
  } else {
    x = 60 + t0 * 1300 + (rand() - 0.5) * 60;
    y = 712 + rand() * 40;
    theta = -Math.PI / 2 + (rand() - 0.5) * 0.8; // heading up
  }
  // Length, wave and curl: the tip hooks harder, which is what makes it read as a tentacle.
  const length = 520 + rand() * 620;
  const waveAmp = 0.16 + rand() * 0.22;
  const waveFreq = 0.7 + rand() * 0.9;
  const phase = rand() * Math.PI * 2;
  const curl = 2.2 + rand() * 2.6;
  const baseWidth = 26 + rand() * 24;

  const centre: { x: number; y: number; w: number; a: number }[] = [];
  const ds = length / STEPS;
  for (let s = 0; s <= STEPS; s++) {
    const t = s / STEPS;
    centre.push({ x, y, w: baseWidth * Math.pow(1 - t, 0.78) + 2.6, a: theta });
    theta += ((Math.sin(t * Math.PI * 2 * waveFreq + phase) * waveAmp + curl * t * t) * ds) / length * 3.1;
    x += Math.cos(theta) * ds;
    y += Math.sin(theta) * ds;
  }

  const left: string[] = [];
  const right: string[] = [];
  const rim: string[] = [];
  const suckers: Arm["suckers"] = [];
  for (let s = 0; s <= STEPS; s++) {
    const p = centre[s];
    const nx = Math.cos(p.a + Math.PI / 2);
    const ny = Math.sin(p.a + Math.PI / 2);
    left.push(`${(p.x + nx * p.w).toFixed(1)},${(p.y + ny * p.w).toFixed(1)}`);
    right.push(`${(p.x - nx * p.w * 0.82).toFixed(1)},${(p.y - ny * p.w * 0.82).toFixed(1)}`);
    // The rim rides the lit side, a little inside the edge.
    if (s % 4 === 0) {
      const iw = p.w * 0.5;
      rim.push(`${(p.x + nx * iw).toFixed(1)},${(p.y + ny * iw).toFixed(1)}`);
    }
    if (s > 6 && s < STEPS - 2 && s % 5 === 0) {
      const t = s / STEPS;
      const off = p.w * 0.34;
      suckers.push({
        cx: (p.x - nx * off).toFixed(1),
        cy: (p.y - ny * off).toFixed(1),
        rx: (p.w * 0.2).toFixed(1),
        ry: (p.w * 0.13).toFixed(1),
        rot: ((p.a * 180) / Math.PI).toFixed(1),
        // nearer the tip the suckers shrink
      } as Arm["suckers"][number]);
      const last = suckers[suckers.length - 1];
      const shrink = 0.45 + 0.55 * (1 - t);
      last.rx = (Number(last.rx) * shrink).toFixed(1);
      last.ry = (Number(last.ry) * shrink).toFixed(1);
    }
  }

  field.push({
    out: `M ${right.join(" L ")} L ${left.reverse().join(" L ")} Z`,
    rim: `M ${rim.join(" L ")}`,
    suckers,
    f: ((i % 2 === 0 ? 1 : -1) * (0.4 + rand() * 0.9)).toFixed(2),
    id: `arm-${seed}-${i}`
  });
}
---

<svg
  class:list={["tentacle-field", cls]}
  viewBox="0 0 1400 700"
  preserveAspectRatio={from === "right" ? "xMaxYMid slice" : "xMidYMax slice"}
  aria-hidden="true"
  data-tentacle-field
  style={`opacity:${opacity}`}
>
  <defs>
    {field.map((a) => (
      <linearGradient id={a.id} gradientUnits="userSpaceOnUse" x1="1400" y1="0" x2="360" y2="0">
        <stop offset="0" stop-color="var(--arm-base)" />
        <stop offset="0.55" stop-color="var(--arm-mid)" />
        <stop offset="1" stop-color="var(--arm-tip)" />
      </linearGradient>
    ))}
  </defs>

  {field.map((a, i) => (
    <g class="arm-outer" style={`--f:${a.f};--i:${i};--dur:${(6.2 + (i % 3) * 1.7).toFixed(1)}s`}>
      <g class="arm">
      <path d={a.out} fill={`url(#${a.id})`} stroke="var(--arm-outline)" stroke-width="2.6" stroke-linejoin="round" />
      <path d={a.rim} fill="none" stroke="var(--arm-rim)" stroke-width="3.4" stroke-linecap="round" opacity="0.55" />
      {a.suckers.map((s) => (
        <ellipse
          cx={s.cx}
          cy={s.cy}
          rx={s.rx}
          ry={s.ry}
          transform={`rotate(${s.rot} ${s.cx} ${s.cy})`}
          fill="var(--arm-sucker)"
          stroke="var(--arm-outline)"
          stroke-width="1.1"
          opacity="0.85"
        />
      ))}
      </g>
    </g>
  ))}
</svg>

<script>
  // Continuous sway lives in CSS; this only steers it: the pointer turns the arms a little, and
  // pointing at the right of the page (where they are) excites them.
  const fields = document.querySelectorAll<SVGSVGElement>("[data-tentacle-field]");
  if (fields.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const step = () => {
      x += (tx - x) * 0.05;
      y += (ty - y) * 0.05;
      for (const svg of fields) {
        svg.style.setProperty("--turn", x.toFixed(3));
        svg.style.setProperty("--rise", y.toFixed(3));
      }
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0015 ? requestAnimationFrame(step) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(step); };
    addEventListener("pointermove", (e) => {
      tx = (e.clientX / innerWidth - 0.5) * 2;
      ty = (e.clientY / innerHeight - 0.5) * 2;
      // Past 55% of the width the pointer is over the arms: they sway harder.
      document.documentElement.classList.toggle("arms-awake", e.clientX > innerWidth * 0.55);
      kick();
    }, { passive: true });
    addEventListener("pointerleave", () => {
      tx = 0; ty = 0;
      document.documentElement.classList.remove("arms-awake");
      kick();
    });
  }
</script>

<style>
  /* Registered so the amplitude can ease between idle and awake instead of snapping. */
  @property --amp {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }
  @property --sway {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  .tentacle-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    --turn: 0;
    --rise: 0;
    --amp: 1;
    overflow: visible;
    filter: drop-shadow(0 -8px 34px rgb(0 0 0 / 32%));
  }

  .palette-silver,
  .tentacle-field {
    --arm-base: #1d2429;
    --arm-mid: #8b989d;
    --arm-tip: #cfeee6;
    --arm-outline: #05090a;
    --arm-rim: #e8f6f2;
    --arm-sucker: #c9d6d4;
  }

  /* Outer: the pointer's small turn. Inner: the arm's own slow sway, always running. */
  .tentacle-field .arm-outer {
    transform-box: fill-box;
    transform-origin: 100% 50%;
    transform: translateY(calc(var(--rise) * 7px))
      rotate(calc(var(--f) * var(--turn) * 2.2deg));
  }

  .tentacle-field .arm {
    transform-box: fill-box;
    transform-origin: 100% 50%;
    animation:
      arm-sway var(--dur, 7s) ease-in-out infinite alternate,
      arm-drift calc(var(--dur, 7s) * 1.7) ease-in-out infinite alternate;
    animation-delay: calc(var(--i, 0) * -1.15s), calc(var(--i, 0) * -2.1s);
    transition: --amp 420ms ease;
    will-change: transform;
  }

  html.arms-awake .tentacle-field .arm { --amp: 2.6; }

  @keyframes arm-sway {
    from { transform: rotate(calc(var(--amp) * -0.9deg)) translateY(calc(var(--amp) * -3px)); }
    to   { transform: rotate(calc(var(--amp) * 0.9deg)) translateY(calc(var(--amp) * 2px)); }
  }

  @keyframes arm-drift {
    from { scale: calc(1 - var(--amp) * 0.004); }
    to   { scale: calc(1 + var(--amp) * 0.006); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tentacle-field .arm,
    .tentacle-field .arm-outer { animation: none; transform: none; }
  }
</style>
