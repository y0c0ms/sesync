---
import '../styles/site.css';
import '../styles/designs.css';

interface Props {
  /** Which design: "v-a" obsidian, "v-b" paper and ink, "v-c" deep. */
  variant: "v-a" | "v-b" | "v-c";
  title: string;
  description: string;
  /** Show the design chooser in the header. */
  chooser?: boolean;
}

const { variant, title, description, chooser = true } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const repo = 'https://github.com/y0c0ms/sesync';
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}media/brand/mark.png`} type="image/png" />
    <script is:inline>document.documentElement.classList.replace("no-js", "js");</script>
  </head>
  <body class:list={["design-body", variant]}>
    <div class="tide" aria-hidden="true"></div>
    <header class="top">
      <a class="brand" href={`${base}designs/`}>
        <img src={`${base}media/brand/mark.png`} alt="" width="64" height="66" />
        <span>sesync</span>
      </a>
      <nav aria-label="Page sections">
        {chooser && <a href={`${base}designs/`}>Designs</a>}
        <a href="#what">What it is</a>
        <a href="#tui">TUI</a>
        <a href="#herdr">herdr</a>
        <a href="#phone">Phone</a>
        <a href="#machines">Machines</a>
        <a href="#flags">Commands</a>
        <a href="#install">Install</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <p>
        sesync is MIT licensed. <a href={`${repo}/blob/main/LICENSE`}>LICENSE</a> ·
        <a href={repo}>Source</a> · <a href={`${repo}/blob/main/README.md`}>README</a>
      </p>
    </footer>

    <script>
      // Reveal sections once, as they come into view.
      const reveal = document.querySelectorAll<HTMLElement>("[data-reveal], main > section");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        for (const el of reveal) io.observe(el);
      } else {
        for (const el of reveal) el.classList.add("in");
      }

      // The tide line follows scroll depth.
      const tide = document.querySelector<HTMLElement>(".tide");
      if (tide) {
        const paint = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const v = max > 0 ? Math.min(1, window.scrollY / max) : 0;
          tide.style.transform = `scaleX(${v})`;
        };
        addEventListener("scroll", paint, { passive: true });
        paint();
      }
    </script>
    <slot name="script" />
  </body>
</html>
